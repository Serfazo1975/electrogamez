<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Facturas emitidas · ElectroGamez</title>
<style>
  :root{--bg:#0b1020;--card:#131a30;--line:#243056;--txt:#e8ecf8;--mut:#93a0c4;--cy:#22d3ee;--ok:#34d399;--bad:#f87171;--warn:#fbbf24}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--txt);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
  a{color:var(--cy)}
  .wrap{max-width:1150px;margin:0 auto;padding:20px 16px 60px}
  header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:18px}
  h1{margin:0;font-size:1.5rem}
  h1 small{display:block;font-size:.8rem;font-weight:400;color:var(--mut);margin-top:2px}
  .btn{background:var(--card);color:var(--txt);border:1px solid var(--line);border-radius:10px;padding:9px 14px;font-size:.9rem;cursor:pointer;text-decoration:none;display:inline-block}
  .btn:hover{border-color:var(--cy)}
  .btn.pri{background:var(--cy);color:#04222a;border-color:var(--cy);font-weight:700}
  .btn.sm{padding:6px 10px;font-size:.8rem}
  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:16px}
  .stat{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}
  .stat b{display:block;font-size:1.35rem;margin-top:4px}
  .stat span{color:var(--mut);font-size:.8rem}
  .filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}
  input,select{background:var(--card);color:var(--txt);border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-size:.9rem}
  input.q{flex:1;min-width:220px}
  .tablebox{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow-x:auto}
  table{width:100%;border-collapse:collapse;min-width:700px}
  th,td{padding:10px 9px;text-align:left;border-bottom:1px solid var(--line);font-size:.88rem;white-space:nowrap}
  th{color:var(--mut);font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em}
  tr:last-child td{border-bottom:0}
  td.r,th.r{text-align:right}
  .badge{padding:3px 9px;border-radius:99px;font-size:.72rem;font-weight:700}
  .b-ok{background:#064e3b;color:var(--ok)} .b-bad{background:#4c1d1d;color:var(--bad)}
  .b-prod{background:#0c3a44;color:var(--cy)} .b-homo{background:#4a3a08;color:var(--warn)}
  .empty{padding:40px;text-align:center;color:var(--mut)}
  .msg{background:#4c1d1d;border:1px solid #7f2d2d;border-radius:12px;padding:14px;margin-bottom:14px}
  .msg.info{background:#0c3a44;border-color:#155e75}
  /* Modal */
  .modal{position:fixed;inset:0;background:rgba(3,6,16,.85);display:none;overflow:auto;z-index:50;padding:16px}
  .modal.on{display:block}
  .toolbar{max-width:820px;margin:0 auto 12px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
  .toolbar .l{display:flex;gap:8px;align-items:center;flex-wrap:wrap;color:var(--mut);font-size:.85rem}
  /* Comprobante (hoja blanca) */
  #comprobante{background:#fff;color:#000;max-width:820px;margin:0 auto;padding:22px 26px;font-family:Arial,Helvetica,sans-serif;font-size:12px;position:relative}
  #comprobante .orig{text-align:center;font-weight:bold;font-size:15px;border:1px solid #000;padding:5px;letter-spacing:2px}
  #comprobante .cab{display:grid;grid-template-columns:1fr 70px 1fr;border:1px solid #000;border-top:0}
  #comprobante .cab>div{padding:10px 12px}
  #comprobante .letra{border-left:1px solid #000;border-right:1px solid #000;text-align:center;padding:6px 0}
  #comprobante .letra .L{font-size:38px;font-weight:bold;line-height:1}
  #comprobante .letra .c{font-size:9px;font-weight:bold}
  #comprobante h2{margin:0 0 6px;font-size:17px}
  #comprobante .box{border:1px solid #000;border-top:0;padding:8px 12px}
  #comprobante table{min-width:0;margin-top:8px}
  #comprobante th{background:#e9e9e9;color:#000;font-size:11px;text-transform:none;letter-spacing:0;border:1px solid #000;padding:5px 6px}
  #comprobante td{border:1px solid #bbb;padding:5px 6px;font-size:11.5px;white-space:normal}
  #comprobante .tot{margin-top:10px;text-align:right;font-size:15px;font-weight:bold}
  #comprobante .pie{display:flex;justify-content:space-between;align-items:center;gap:14px;border:1px solid #000;padding:10px 12px;margin-top:16px}
  #comprobante .pie img{width:110px;height:110px}
  #comprobante .marca{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:54px;font-weight:bold;color:rgba(200,0,0,.16);transform:rotate(-24deg);text-align:center;pointer-events:none}
  @media print{
    body *{visibility:hidden}
    #comprobante,#comprobante *{visibility:visible}
    #comprobante{position:absolute;left:0;top:0;width:100%;max-width:none;padding:0}
    .modal{background:#fff;overflow:visible}
    @page{size:A4;margin:12mm}
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>🧾 Facturas emitidas<small>ElectroGamez · Historial y reimpresión de comprobantes ARCA</small></h1>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" id="btnRef">↻ Actualizar</button>
      <button class="btn" id="btnCsv">⬇ Exportar CSV</button>
      <a class="btn pri" href="/admin/facturacion">+ Nueva factura</a>
      <a class="btn" href="/dashboard">← Dashboard</a>
    </div>
  </header>

  <div id="aviso"></div>

  <div class="stats">
    <div class="stat"><span>Facturas válidas (con CAE)</span><b id="sOk">–</b></div>
    <div class="stat"><span>Total facturado (producción)</span><b id="sTot">–</b></div>
    <div class="stat"><span>Rechazadas / con error</span><b id="sBad">–</b></div>
    <div class="stat"><span>Última emitida</span><b id="sUlt">–</b></div>
  </div>

  <div class="filters">
    <input class="q" id="q" placeholder="Buscar por N° de comprobante, CAE, CUIT/DNI o monto…">
    <select id="fEst"><option value="">Todos los estados</option><option value="A">Aprobadas</option><option value="R">Rechazadas / error</option></select>
    <select id="fEnt"><option value="">Producción y prueba</option><option value="prod">Solo producción</option><option value="homo">Solo prueba</option></select>
    <select id="fPer"><option value="">Todo el historial</option><option value="mes">Este mes</option><option value="30">Últimos 30 días</option><option value="anio">Este año</option></select>
  </div>

  <div class="tablebox">
    <table>
      <thead><tr>
        <th>Comprobante</th><th>Fecha</th><th>Cliente (doc.)</th><th class="r">Total</th><th>CAE</th><th>Vto. CAE</th><th>Estado</th><th></th>
      </tr></thead>
      <tbody id="tb"><tr><td colspan="8" class="empty">Cargando…</td></tr></tbody>
    </table>
  </div>
</div>

<!-- Vista previa / reimpresión -->
<div class="modal" id="modal">
  <div class="toolbar">
    <div class="l">
      <span>Nombre del cliente (opcional):</span>
      <input id="cliNom" placeholder="Consumidor Final" style="min-width:230px">
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn pri" id="btnPrint">🖨 Imprimir / Guardar PDF</button>
      <button class="btn" id="btnWa">💬 Enviar por WhatsApp</button>
      <button class="btn" id="btnClose">✕ Cerrar</button>
    </div>
  </div>
  <div id="comprobante"></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
/* ==========================================================
   DATOS FIJOS DEL EMISOR — completar los que estén vacíos con
   los mismos datos que ya salen en tu comprobante actual.
   (Las líneas vacías simplemente no se muestran.)
   ========================================================== */
const EMISOR = {
  fantasia:   'ELECTROGAMEZ SERVICIO TÉCNICO RG',
  razonSocial:'',                 // ← Razón social tal como figura en ARCA
  cuit:       '20-21429328-6',
  domicilio:  'Los Pozos 458, Río Gallegos, Santa Cruz',
  condIva:    'Responsable Monotributo',
  iibb:       '',                 // ← Ingresos Brutos
  inicioAct:  '',                 // ← Inicio de actividades (dd/mm/aaaa)
  telefono:   '2966-383251',
  leyenda:    ''                  // ← Leyenda opcional al pie
};

const COND_IVA = {1:'IVA Responsable Inscripto',4:'IVA Sujeto Exento',5:'Consumidor Final',6:'Responsable Monotributo',7:'Sujeto No Categorizado',8:'Proveedor del Exterior',9:'Cliente del Exterior',10:'IVA Liberado',13:'Monotributista Social',15:'IVA No Alcanzado'};
const DOC_TIPO = {80:'CUIT',86:'CUIL',96:'DNI',99:'Doc.',0:'CI Policía Federal'};
const CBTE = {1:['A','001','FACTURA'],6:['B','006','FACTURA'],11:['C','011','FACTURA'],3:['A','003','NOTA DE CRÉDITO'],8:['B','008','NOTA DE CRÉDITO'],13:['C','013','NOTA DE CRÉDITO'],2:['A','002','NOTA DE DÉBITO'],7:['B','007','NOTA DE DÉBITO'],12:['C','012','NOTA DE DÉBITO']};

let DATA = [];
let FILTRADAS = [];
let ACTUAL = null;

const $ = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money = n => Number(n||0).toLocaleString('es-AR',{style:'currency',currency:'ARS'});
const pad = (n,l) => String(n).padStart(l,'0');
const esOk = f => f.resultado === 'A' && !!f.cae;
const fmtNro = f => pad(f.pto_vta,4) + '-' + pad(f.cbte_nro,8);
const fechaAR = iso => iso ? new Date(iso).toLocaleDateString('es-AR',{timeZone:'America/Argentina/Buenos_Aires'}) : '';
const fechaHoraAR = iso => iso ? new Date(iso).toLocaleString('es-AR',{timeZone:'America/Argentina/Buenos_Aires'}) : '';
const vtoFmt = v => /^\d{8}$/.test(v||'') ? v.slice(6,8)+'/'+v.slice(4,6)+'/'+v.slice(0,4) : (v||'–');
const ymd = iso => new Date(iso).toLocaleDateString('en-CA',{timeZone:'America/Argentina/Buenos_Aires'});

async function cargar(){
  $('aviso').innerHTML = '';
  $('tb').innerHTML = '<tr><td colspan="8" class="empty">Cargando…</td></tr>';
  try{
    const r = await fetch('/api/facturas',{credentials:'same-origin',cache:'no-store'});
    if(r.status === 401){
      $('aviso').innerHTML = '<div class="msg">🔒 Necesitás iniciar sesión como administrador. Entrá por <a href="/tienda?admin=1">/tienda?admin=1</a> (o desde el Dashboard) y volvé a abrir esta página.</div>';
      $('tb').innerHTML = '<tr><td colspan="8" class="empty">Sin acceso</td></tr>';
      return;
    }
    const j = await r.json();
    if(!r.ok) throw new Error(j.detalle || j.error || 'Error');
    DATA = j.facturas || [];
    filtrar();
  }catch(e){
    $('aviso').innerHTML = '<div class="msg">No se pudo cargar el historial: ' + esc(e.message) + '</div>';
    $('tb').innerHTML = '<tr><td colspan="8" class="empty">Error al cargar</td></tr>';
  }
}

function filtrar(){
  const q = $('q').value.trim().toLowerCase();
  const est = $('fEst').value, ent = $('fEnt').value, per = $('fPer').value;
  const hoy = new Date(); const hoyS = ymd(hoy.toISOString());
  FILTRADAS = DATA.filter(f=>{
    if(est === 'A' && !esOk(f)) return false;
    if(est === 'R' && esOk(f)) return false;
    if(ent && f.entorno !== ent) return false;
    if(per){
      const d = ymd(f.creado);
      if(per === 'mes' && d.slice(0,7) !== hoyS.slice(0,7)) return false;
      if(per === 'anio' && d.slice(0,4) !== hoyS.slice(0,4)) return false;
      if(per === '30' && (hoy - new Date(f.creado)) > 30*864e5) return false;
    }
    if(q){
      const hay = [fmtNro(f), f.cbte_nro, f.cae, f.doc_nro, String(f.imp_total), money(f.imp_total)].join(' ').toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });
  pintar();
}

function pintar(){
  // Resumen sobre TODO el historial (no sobre el filtro)
  const ok = DATA.filter(esOk);
  const totProd = ok.filter(f=>f.entorno==='prod').reduce((s,f)=>s+Number(f.imp_total),0);
  $('sOk').textContent = ok.length;
  $('sTot').textContent = money(totProd);
  $('sBad').textContent = DATA.length - ok.length;
  $('sUlt').textContent = ok.length ? fmtNro(ok[0]) : '–';

  if(!FILTRADAS.length){
    $('tb').innerHTML = '<tr><td colspan="8" class="empty">No hay facturas para mostrar.</td></tr>';
    return;
  }
  $('tb').innerHTML = FILTRADAS.map(f=>{
    const cb = CBTE[f.cbte_tipo] || ['?','', 'COMPROBANTE'];
    const doc = Number(f.doc_tipo) === 99 ? 'Consumidor Final' : ((DOC_TIPO[f.doc_tipo]||'Doc.') + ' ' + esc(f.doc_nro));
    return '<tr>'
      + '<td><b>' + esc(cb[2]) + ' ' + cb[0] + '</b> ' + fmtNro(f) + '</td>'
      + '<td>' + fechaHoraAR(f.creado) + '</td>'
      + '<td>' + doc + '</td>'
      + '<td class="r"><b>' + money(f.imp_total) + '</b></td>'
      + '<td>' + (f.cae ? esc(f.cae) + ' <button class="btn sm" data-cp="'+esc(f.cae)+'" title="Copiar CAE">⧉</button>' : '–') + '</td>'
      + '<td>' + vtoFmt(f.cae_vto) + '</td>'
      + '<td>' + (esOk(f) ? '<span class="badge b-ok">✓ Aprobada</span>' : '<span class="badge b-bad" title="'+esc(f.observaciones||'')+'">✕ Rechazada</span>') + (f.entorno==='prod' ? '' : ' <span class="badge b-homo">Prueba</span>') + '</td>'
      + '<td>' + (esOk(f) ? '<button class="btn sm pri" data-id="'+f.id+'">🖨 Ver / Reimprimir</button>' : '') + '</td>'
      + '</tr>';
  }).join('');
}

/* ---------- Comprobante ---------- */
function itemsDe(f){
  let d = f.detalle;
  if(typeof d === 'string'){ try{ d = JSON.parse(d);}catch(e){ d = null; } }
  if(d && !Array.isArray(d) && Array.isArray(d.items)) d = d.items;
  if(!Array.isArray(d)) return [];
  return d.map(it=>{
    const desc = it.descripcion ?? it.description ?? it.detalle ?? it.nombre ?? it.concepto ?? it.producto ?? '';
    const cant = Number(it.cantidad ?? it.qty ?? it.cant ?? 1) || 1;
    let pu = it.precioUnitario ?? it.precio_unitario ?? it.precio ?? it.price ?? it.unitPrice ?? it.importe ?? null;
    pu = pu == null ? null : Number(pu);
    const sub = it.subtotal != null ? Number(it.subtotal) : (pu != null ? pu*cant : null);
    return {desc, cant, pu: pu != null ? pu : (sub != null ? sub/cant : null), sub};
  });
}

function qrArca(f){
  const cb = f.cbte_tipo;
  const fecha = ymd(f.creado);
  const payload = {
    ver:1, fecha, cuit: Number(EMISOR.cuit.replace(/\D/g,'')), ptoVta: Number(f.pto_vta),
    tipoCmp: Number(cb), nroCmp: Number(f.cbte_nro), importe: Number(f.imp_total),
    moneda:'PES', ctz:1, tipoDocRec: Number(f.doc_tipo), nroDocRec: Number(f.doc_nro),
    tipoCodAut:'E', codAut: Number(f.cae)
  };
  const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
  return 'https://www.afip.gob.ar/fe/qr/?p=' + b64;
}

function qrDataUrl(texto){
  return new Promise(res=>{
    try{
      if(typeof QRCode === 'undefined') return res('');
      const tmp = document.createElement('div');
      tmp.style.cssText = 'position:fixed;left:-9999px;top:0';
      document.body.appendChild(tmp);
      new QRCode(tmp,{text:texto,width:220,height:220,correctLevel:QRCode.CorrectLevel.M});
      setTimeout(()=>{
        const c = tmp.querySelector('canvas'); const im = tmp.querySelector('img');
        const out = c ? c.toDataURL('image/png') : (im ? im.src : '');
        tmp.remove(); res(out);
      },60);
    }catch(e){ res(''); }
  });
}

async function abrir(id){
  const f = DATA.find(x=>String(x.id)===String(id));
  if(!f) return;
  ACTUAL = f;
  $('cliNom').value = '';
  $('modal').classList.add('on');
  document.body.style.overflow = 'hidden';
  await dibujar();
}

async function dibujar(){
  const f = ACTUAL; if(!f) return;
  const cb = CBTE[f.cbte_tipo] || ['C','011','FACTURA'];
  const items = itemsDe(f);
  const nombre = $('cliNom').value.trim();
  const esCF = Number(f.doc_tipo) === 99;
  const qr = await qrDataUrl(qrArca(f));
  const filas = items.length
    ? items.map(it=>'<tr><td>'+esc(it.desc)+'</td><td style="text-align:center">'+it.cant+'</td><td style="text-align:right">'+(it.pu!=null?money(it.pu):'')+'</td><td style="text-align:right">'+(it.sub!=null?money(it.sub):'')+'</td></tr>').join('')
    : '<tr><td>Detalle no disponible en el registro</td><td style="text-align:center">1</td><td style="text-align:right">'+money(f.imp_total)+'</td><td style="text-align:right">'+money(f.imp_total)+'</td></tr>';
  const l = (t,v) => v ? '<div><b>'+t+':</b> '+esc(v)+'</div>' : '';
  const homo = f.entorno !== 'prod';

  $('comprobante').innerHTML =
    (homo ? '<div class="marca">COMPROBANTE DE PRUEBA<br>SIN VALIDEZ FISCAL</div>' : '') +
    '<div class="orig">ORIGINAL</div>' +
    '<div class="cab">' +
      '<div><h2>' + esc(EMISOR.fantasia) + '</h2>' +
        l('Razón Social', EMISOR.razonSocial) + l('Domicilio Comercial', EMISOR.domicilio) +
        l('Condición frente al IVA', EMISOR.condIva) + l('Tel.', EMISOR.telefono) + '</div>' +
      '<div class="letra"><div class="L">' + cb[0] + '</div><div class="c">COD. ' + cb[1] + '</div></div>' +
      '<div><h2>' + cb[2] + '</h2>' +
        '<div><b>Punto de Venta:</b> ' + pad(f.pto_vta,4) + ' &nbsp; <b>Comp. Nro:</b> ' + pad(f.cbte_nro,8) + '</div>' +
        '<div><b>Fecha de Emisión:</b> ' + fechaAR(f.creado) + '</div>' +
        l('CUIT', EMISOR.cuit) + l('Ingresos Brutos', EMISOR.iibb) + l('Fecha de Inicio de Actividades', EMISOR.inicioAct) + '</div>' +
    '</div>' +
    '<div class="box">' +
      (esCF ? '<div><b>Apellido y Nombre / Razón Social:</b> ' + esc(nombre || 'Consumidor Final') + '</div>'
            : '<div><b>' + (DOC_TIPO[f.doc_tipo]||'Doc.') + ':</b> ' + esc(f.doc_nro) + ' &nbsp; <b>Apellido y Nombre / Razón Social:</b> ' + esc(nombre) + '</div>') +
      '<div><b>Condición frente al IVA:</b> ' + esc(COND_IVA[f.cond_iva_receptor] || 'Consumidor Final') + ' &nbsp; <b>Condición de venta:</b> Contado</div>' +
    '</div>' +
    '<table><thead><tr><th>Descripción</th><th style="width:70px">Cant.</th><th style="width:120px">Precio Unit.</th><th style="width:120px">Subtotal</th></tr></thead><tbody>' + filas + '</tbody></table>' +
    '<div class="tot">Importe Total: ' + money(f.imp_total) + '</div>' +
    '<div class="pie">' +
      (qr ? '<img alt="QR ARCA" src="' + qr + '">' : '<div></div>') +
      '<div style="flex:1"><div style="font-size:15px;font-weight:bold;letter-spacing:1px">ARCA</div>' +
        '<div style="font-size:9px;color:#444">AGENCIA DE RECAUDACIÓN Y CONTROL ADUANERO</div>' +
        '<div style="font-size:12px;font-weight:bold;font-style:italic;margin-top:4px">Comprobante Autorizado</div>' +
        (EMISOR.leyenda ? '<div style="font-size:10px;margin-top:4px">'+esc(EMISOR.leyenda)+'</div>' : '') + '</div>' +
      '<div style="text-align:right"><div><b>CAE N°:</b> ' + esc(f.cae) + '</div><div><b>Fecha de Vto. de CAE:</b> ' + vtoFmt(f.cae_vto) + '</div>' +
        '<div style="font-size:9px;color:#555;margin-top:6px">Reimpresión · ' + fechaHoraAR(new Date().toISOString()) + '</div></div>' +
    '</div>';
}

function cerrar(){ $('modal').classList.remove('on'); document.body.style.overflow=''; ACTUAL=null; }

function csv(){
  const rows = [['ID','Fecha','Tipo','Comprobante','Doc. tipo','Doc. nro','Total','Neto','IVA','CAE','Vto CAE','Estado','Entorno']];
  FILTRADAS.forEach(f=>rows.push([f.id, fechaHoraAR(f.creado), (CBTE[f.cbte_tipo]||[])[0]||f.cbte_tipo, fmtNro(f), f.doc_tipo, f.doc_nro, f.imp_total, f.imp_neto, f.imp_iva, f.cae||'', f.cae_vto||'', esOk(f)?'Aprobada':'Rechazada', f.entorno]));
  const txt = rows.map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(';')).join('\r\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob(['\ufeff'+txt],{type:'text/csv;charset=utf-8'}));
  a.download = 'facturas-electrogamez-' + ymd(new Date().toISOString()) + '.csv';
  a.click();
}

/* ---------- Eventos ---------- */
$('btnRef').onclick = cargar;
$('btnCsv').onclick = csv;
['q','fEst','fEnt','fPer'].forEach(id=>{ $(id).addEventListener(id==='q'?'input':'change', filtrar); });
$('tb').addEventListener('click', e=>{
  const b = e.target.closest('button'); if(!b) return;
  if(b.dataset.id) abrir(b.dataset.id);
  if(b.dataset.cp){ navigator.clipboard && navigator.clipboard.writeText(b.dataset.cp); b.textContent='✓'; setTimeout(()=>b.textContent='⧉',1200); }
});
$('btnClose').onclick = cerrar;
$('btnPrint').onclick = () => window.print();
$('cliNom').addEventListener('input', dibujar);
$('btnWa').onclick = () => {
  const f = ACTUAL; if(!f) return;
  const txt = 'ElectroGamez - Factura ' + (CBTE[f.cbte_tipo]||['C'])[0] + ' N° ' + fmtNro(f) + '\nFecha: ' + fechaAR(f.creado) + '\nTotal: ' + money(f.imp_total) + '\nCAE: ' + f.cae + ' (vto. ' + vtoFmt(f.cae_vto) + ')\nGracias por tu compra!';
  window.open('https://wa.me/?text=' + encodeURIComponent(txt), '_blank');
};
document.addEventListener('keydown', e=>{ if(e.key==='Escape' && $('modal').classList.contains('on')) cerrar(); });

cargar();
</script>
